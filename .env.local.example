# ==============================================================================
# ECLIPSE ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development.
# For Vercel deployment, configure these in Project Settings -> Environment Variables.
# ==============================================================================

# --- SUPABASE (Required) ---
# Project URL and public API key from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional alias if using Supabase publishable keys:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# --- TMDB (The Movie Database) (Required) ---
# API Key from https://www.themoviedb.org/settings/api (v3 auth API key)
TMDB_API_KEY=your-tmdb-api-key

# --- GEMINI AI (Required for Stretch Recommendations) ---
# API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key
# Optional: comma-separated fallback models (default: gemini-2.0-flash)
GEMINI_MODELS=gemini-2.0-flash

# --- GROQ AI (Required for Parallel Similar Recommendations) ---
# API key from Groq Console (https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
# Model identifier (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# --- OMDB (Open Movie Database) (Optional) ---
# API key from https://www.omdbapi.com/apikey.aspx for IMDb ratings, Rotten Tomatoes %, Metacritic & awards
OMDB_API_KEY=your-omdb-api-key
